msgid "Cast"
msgstr "Cast"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:212
msgid "Stop casting"
msgstr "Übertragung beenden"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:220
