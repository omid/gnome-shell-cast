#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:227
#: extension/gnome-shell-cast@oxygenws.com/lib/quickIndicator.js:49
msgid "Cast"
msgstr "پخش"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:271
msgid "Stop casting"
msgstr "توقف پخش"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:279
msgid "Preferences"
msgstr "ترجیحات"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:336
#, javascript-format
msgid "%s (casting)"
msgstr "%s (در حال پخش)"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:344
msgid "Searching for Chromecast devices…"
msgstr "در حال جست‌وجوی دستگاه‌های کروم‌کست…"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:395
msgid "Cast screen"
msgstr "پخش صفحه"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:402
msgid "Choose what to cast"
msgstr "انتخاب آنچه پخش می‌شود"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:416
msgid "Cast streaming"
msgstr "جریان کست"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:416
msgid "Audio stream"
msgstr "جریان صدا"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:417
msgid "HLS"
msgstr "HLS"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:421
#, javascript-format
msgid "Receiver supports: %s"
msgstr "گیرنده پشتیبانی می‌کند: %s"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:480
msgid "The cast failed."
msgstr "پخش ناموفق بود."

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:487
#, javascript-format
msgid "The device ended the session (%s)."
msgstr "دستگاه نشست را پایان داد (%s)."

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:488
msgid "The device ended the session."
msgstr "دستگاه نشست را پایان داد."

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:536
#: extension/gnome-shell-cast@oxygenws.com/lib/indicator.js:20
