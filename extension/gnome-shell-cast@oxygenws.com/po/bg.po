#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:290
#, javascript-format
msgid "%s (casting)"
msgstr "%s (предаване)"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:298
msgid "Searching for Chromecast devices…"
msgstr "Търсене на устройства Chromecast…"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:347
msgid "Cast screen"
msgstr "Предаване на екрана"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:352
