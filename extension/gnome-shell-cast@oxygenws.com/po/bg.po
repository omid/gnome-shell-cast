msgstr "Аудио поток"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:366
msgid "HLS"
msgstr "HLS"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:374
