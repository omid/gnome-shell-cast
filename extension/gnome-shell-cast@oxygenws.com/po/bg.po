msgstr "Кодер: %s (хардуерен)"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:375
#, javascript-format
msgid "Encoder: %s (software)"
msgstr "Кодер: %s (софтуерен)"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:381
#, javascript-format
msgid "Receiver supports: %s"
msgstr "Приемникът поддържа: %s"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:446
msgid "The cast failed."
msgstr "Предаването е неуспешно."

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:453
#, javascript-format
