msgstr "Bar atas"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:112
msgid "Quick settings"
msgstr "Pengaturan cepat"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:115
msgid "General"
