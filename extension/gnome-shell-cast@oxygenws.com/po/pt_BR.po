#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:176
#: extension/gnome-shell-cast@oxygenws.com/lib/quickIndicator.js:57
msgid "Cast"
msgstr "Cast"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:220
msgid "Stop casting"
msgstr "Parar a transmissão"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:228
msgid "Preferences"
msgstr "Preferências"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:285
#, javascript-format
msgid "%s (casting)"
msgstr "%s (transmitindo)"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:293
msgid "Searching for Chromecast devices…"
msgstr "Procurando dispositivos Chromecast…"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:342
msgid "Cast screen"
msgstr "Transmitir a tela"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:347
msgid "Choose what to cast"
msgstr "Escolher o que transmitir"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:360
msgid "Cast streaming"
msgstr "Cast Streaming"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:360
msgid "Audio stream"
msgstr "Fluxo de áudio"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:361
msgid "HLS"
msgstr "HLS"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:368
#, javascript-format
msgid "Encoder: %s"
msgstr "Codificador: %s"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:372
#, javascript-format
msgid "Receiver supports: %s"
msgstr "O receptor tem suporte a: %s"

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:433
msgid "The cast failed."
msgstr "A transmissão falhou."

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:440
#, javascript-format
msgid "The device ended the session (%s)."
msgstr "O dispositivo encerrou a sessão (%s)."

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:441
msgid "The device ended the session."
msgstr "O dispositivo encerrou a sessão."

#: extension/gnome-shell-cast@oxygenws.com/lib/castMenu.js:489
#: extension/gnome-shell-cast@oxygenws.com/lib/indicator.js:22
#: extension/gnome-shell-cast@oxygenws.com/lib/quickIndicator.js:62
msgid "GNOME Shell Cast"
msgstr "GNOME Shell Cast"

#: extension/gnome-shell-cast@oxygenws.com/lib/daemonSetup.js:55
#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:16
msgid "Set up the cast daemon"
msgstr "Configurar o serviço de transmissão"

#: extension/gnome-shell-cast@oxygenws.com/lib/daemonSetup.js:57
msgid ""
"The cast daemon isn’t installed yet. Open the menu and click “Set up the "
"cast daemon” to install it."
msgstr ""
"O serviço de transmissão ainda não está instalado. Abra o menu e clique em "
"“Configurar o serviço de transmissão” para instalá-lo."

#: extension/gnome-shell-cast@oxygenws.com/lib/daemonSetup.js:64
msgid "Update the cast daemon (v%old → v%new)"
msgstr "Atualizar o serviço de transmissão (v%old → v%new)"

#: extension/gnome-shell-cast@oxygenws.com/lib/daemonSetup.js:68
msgid ""
"The cast daemon (v%old) doesn’t match this version of the extension (needs "
"v%new). Open the menu to update it."
msgstr ""
"O serviço de transmissão (v%old) não corresponde a esta versão da extensão "
"(precisa da v%new). Abra o menu para atualizá-lo."

#: extension/gnome-shell-cast@oxygenws.com/lib/errorDialog.js:16
msgid "Casting failed"
msgstr "Falha na transmissão"

#: extension/gnome-shell-cast@oxygenws.com/lib/errorDialog.js:18
msgid "If this keeps happening, please report it (that helps get it fixed)."
msgstr ""
"Se isso continuar acontecendo, relate o problema (isso ajuda a corrigi-lo)."

#: extension/gnome-shell-cast@oxygenws.com/lib/errorDialog.js:31
msgid ""
"The report will include this error, the version, and a reminder to attach "
"logs."
msgstr ""
"O relatório incluirá este erro, a versão e um lembrete para anexar os "
"registros."

#: extension/gnome-shell-cast@oxygenws.com/lib/errorDialog.js:36
msgid "Copy details"
msgstr "Copiar detalhes"

#: extension/gnome-shell-cast@oxygenws.com/lib/errorDialog.js:37
#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:44
msgid "Close"
msgstr "Fechar"

#: extension/gnome-shell-cast@oxygenws.com/lib/errorDialog.js:40
#: extension/gnome-shell-cast@oxygenws.com/prefs.js:169
msgid "Report an issue"
msgstr "Relatar um problema"

#: extension/gnome-shell-cast@oxygenws.com/lib/errorDialog.js:47
msgid "Copied! Paste it into a new issue."
msgstr "Copiado. Cole em um novo relato."

#: extension/gnome-shell-cast@oxygenws.com/lib/quickIndicator.js:26
#, javascript-format
msgid "%s volume"
msgstr "Volume de %s"

#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:16
msgid "Update the cast daemon"
msgstr "Atualizar o serviço de transmissão"

#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:19
msgid ""
"A newer version of the extension needs a matching daemon (installed v%old → "
"needs v%new). Run the command below to update it (nothing runs as root)."
msgstr ""
"Uma versão mais recente da extensão precisa de um serviço correspondente "
"(v%old instalada → precisa da v%new). Execute o comando abaixo para atualizá-"
"lo (nada é executado como root)."

#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:26
msgid ""
"GNOME Shell Cast needs a small background daemon. It can't be shipped "
"through extensions.gnome.org, so install it once with the command below. It "
"downloads a checksum-verified binary to ~/.local/bin (nothing runs as root)."
msgstr ""
"O GNOME Shell Cast precisa de um pequeno serviço em segundo plano. Ele não "
"pode ser distribuído pelo extensions.gnome.org, então instale-o uma vez com "
"o comando abaixo. Ele baixa um binário verificado por soma de verificação em "
"~/.local/bin (nada é executado como root)."

#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:41
msgid "Copy the command, then paste it into a terminal and run it."
msgstr "Copie o comando, cole-o em um terminal e execute-o."

#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:43
#: extension/gnome-shell-cast@oxygenws.com/prefs.js:168
msgid "Homepage"
msgstr "Site"

#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:47
msgid "Copy command"
msgstr "Copiar o comando"

#: extension/gnome-shell-cast@oxygenws.com/lib/setupDialog.js:54
msgid "Copied! Paste it into a terminal and run it."
msgstr "Copiado. Cole-o em um terminal e execute-o."

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:29
msgid "Native"
msgstr "Nativa"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:29
msgid "4K (2160p)"
msgstr "4K (2160p)"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:29
msgid "1440p"
msgstr "1440p"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:29
msgid "1080p"
msgstr "1080p"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:29
msgid "720p"
msgstr "720p"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:30
#: extension/gnome-shell-cast@oxygenws.com/prefs.js:31
msgid "Automatic"
msgstr "Automático"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:30
msgid "Hardware only"
msgstr "Somente hardware"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:30
msgid "Software only"
msgstr "Somente software"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:34
msgid "Video"
msgstr "Vídeo"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:40
msgid "Stream quality"
msgstr "Qualidade da transmissão"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:41
msgid "Applied the next time a cast is started"
msgstr "Aplicado na próxima vez que uma transmissão for iniciada"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:46
#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:14
msgid "Maximum resolution"
msgstr "Resolução máxima"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:47
msgid "Above 1080p needs a hardware encoder and a matching bitrate"
msgstr ""
"Acima de 1080p é necessário um codificador de hardware e uma taxa de bits "
"compatível"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:57
msgid "Framerate"
msgstr "Taxa de quadros"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:58
msgid "Frames per second"
msgstr "Quadros por segundo"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:69
msgid "Video bitrate"
msgstr "Taxa de bits do vídeo"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:70
msgid "kbit/s: about 4000 for 720p, 8000 for 1080p, 30000 for 4K"
msgstr "kbit/s: cerca de 4000 para 720p, 8000 para 1080p, 30000 para 4K"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:81
msgid "Encoding"
msgstr "Codificação"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:82
msgid "Casting fails with a message when a forced choice cannot be used"
msgstr ""
"A transmissão falha com uma mensagem quando uma escolha forçada não pode ser "
"usada"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:87
#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:35
msgid "Video encoder"
msgstr "Codificador de vídeo"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:89
msgid ""
"Automatic prefers your graphics card; choose software if the picture breaks "
"up"
msgstr ""
"Automático prefere sua placa de vídeo; escolha software se a imagem se "
"quebrar"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:100
#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:45
msgid "Pixel format"
msgstr "Formato de pixel"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:101
msgid "Automatic suits every encoder; only change this to work around a driver"
msgstr ""
"Automático serve para qualquer codificador; mude apenas para contornar um "
"driver"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:112
msgid "Top bar"
msgstr "Barra superior"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:112
msgid "Quick settings"
msgstr "Configurações rápidas"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:115
msgid "General"
msgstr "Geral"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:120
msgid "Menu"
msgstr "Menu"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:124
#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:59
msgid "Indicator location"
msgstr "Localização do ícone"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:125
msgid "Show the cast icon in the top bar, or in the quick settings menu"
msgstr ""
"Mostrar o ícone de transmissão na barra superior ou no menu de configurações "
"rápidas"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:135
#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:50
msgid "Show cast details"
msgstr "Mostrar detalhes da transmissão"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:136
#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:51
msgid "Show the transport and codecs under the active device while casting"
msgstr ""
"Mostrar o transporte e os codecs abaixo do dispositivo ativo durante a "
"transmissão"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:146
msgid "About"
msgstr "Sobre"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:157
#, javascript-format
msgid "Version %s"
msgstr "Versão %s"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:172
msgid "Help"
msgstr "Ajuda"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:173
msgid "Common problems and their fixes"
msgstr "Problemas comuns e suas soluções"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:176
msgid "Troubleshooting guide"
msgstr "Guia de solução de problemas"

#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:15
msgid ""
"Scale the captured video down to this size before encoding. \"native\" keeps "
"the captured size. Above 1080p, raise the bitrate to match and expect a "
"hardware encoder to be needed for a smooth stream."
msgstr ""
"Reduzir o vídeo capturado para este tamanho antes de codificar. “native” "
"mantém o tamanho capturado. Acima de 1080p, aumente a taxa de bits na mesma "
"proporção e espere precisar de um codificador de hardware para uma "
"transmissão fluida."

#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:20
msgid "Stream framerate"
msgstr "Taxa de quadros da transmissão"

#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:25
msgid "Video bitrate in kbit/s"
msgstr "Taxa de bits do vídeo em kbit/s"

#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:26
msgid ""
"Roughly 4000 for 720p, 8000 for 1080p, 16000 for 1440p and 30000 for 4K; "
"more for fast-moving content."
msgstr ""
"Aproximadamente 4000 para 720p, 8000 para 1080p, 16000 para 1440p e 30000 "
"para 4K; mais para conteúdo com muito movimento."

#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:36
msgid ""
"Which encoder to use. \"auto\" prefers hardware (VA-API, NVENC) and falls "
"back to software. Choose software when a graphics driver produces a broken "
"or stuttering picture; casting fails with a message if the choice cannot be "
"met."
msgstr ""
"Qual codificador usar. “auto” prefere hardware (VA-API, NVENC) e recorre ao "
"software. Escolha software quando um driver de vídeo produzir uma imagem "
"quebrada ou travando; a transmissão falha com uma mensagem se a escolha não "
"puder ser atendida."

#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:46
msgid ""
"The raw video format handed to the encoder. \"auto\" lets each encoder take "
"the one it prefers: NV12 for hardware encoders, I420 for software ones. "
"Forcing a format restricts casting to encoders that accept it."
msgstr ""
"O formato de vídeo bruto entregue ao codificador. “auto” deixa cada "
"codificador pegar o que prefere: NV12 para codificadores de hardware, I420 "
"para os de software. Forçar um formato restringe a transmissão aos "
"codificadores que o aceitam."

#: extension/gnome-shell-cast@oxygenws.com/schemas/org.gnome.shell.extensions.gnome-shell-cast.gschema.xml:60
msgid ""
"Where to show the cast indicator: the top-bar tray, or the quick settings "
"menu."
msgstr ""
"Onde mostrar o ícone de transmissão: na barra superior ou no menu de "
"configurações rápidas."
