msgstr "Schnelleinstellungen"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:115
msgid "General"
msgstr "Allgemein"

#: extension/gnome-shell-cast@oxygenws.com/prefs.js:120
msgid "Menu"
